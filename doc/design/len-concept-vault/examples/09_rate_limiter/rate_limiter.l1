type Client
type Window
type Request
type Int

rel InWindow(Request, Window)
rel FromClient(Request, Client)
rel RequestCount(Client, Window, Int)
rel Allow(Request)
rel Reject(Request)
rel NewWindow(Window)
rel Zero(Int)

spec limiter_policy(req: Request, client: Client, w: Window) -> ok: Request
requires FromClient(req, client)
requires InWindow(req, w)
ensures exists count: Int. (RequestCount(client, w, count) and count <= 100) -> Allow(req)
ensures exists count: Int. (RequestCount(client, w, count) and count > 100) -> Reject(req)
ensures NewWindow(w) -> exists reset: Int. RequestCount(client, w, reset)
