type Client
type Window
type Request
type Int

rel InWindow(Request, Window)
rel FromClient(Request, Client)
rel RequestCount(Client, Window, Int)
rel Allow(Request)
rel Reject(Request)
rel NewWindow(Window)
rel Zero(Int)

spec limiter_rules(req: Request) -> ok: Request
ensures forall req: Request, c: Client, w: Window, count: Int.
    (FromClient(req, c) and InWindow(req, w) and RequestCount(c, w, count) and count <= 100) -> Allow(req)
ensures forall req: Request, c: Client, w: Window, count: Int.
    (FromClient(req, c) and InWindow(req, w) and RequestCount(c, w, count) and count > 100) -> Reject(req)
ensures forall c: Client, w: Window, count: Int.
    (NewWindow(w) and RequestCount(c, w, count)) -> Zero(count)

