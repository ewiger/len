type Int

rel Nat(Int)
rel Positive(Int)
rel FactorialValue(Int, Int)
fn dec(n: Int) -> Int
fn mul(a: Int, b: Int) -> Int

spec factorial_base(n: Int) -> result: Int
requires n = 0
ensures FactorialValue(n, result)
ensures result = 1

spec factorial_step(n: Int) -> result: Int
requires Nat(n)
requires Positive(n)
ensures FactorialValue(n, result)
ensures exists prev: Int. FactorialValue(dec(n), prev) and result = mul(n, prev)

spec factorial_of_five(n: Int) -> result: Int
requires n = 5
ensures FactorialValue(n, result)
ensures result = 120
