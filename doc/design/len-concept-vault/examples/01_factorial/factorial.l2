type Int

rel Nat(Int)
rel Positive(Int)
rel FactorialValue(Int, Int)
fn dec(n: Int) -> Int
fn mul(a: Int, b: Int) -> Int

spec factorial_axioms(n: Int) -> witness: Int
ensures forall r: Int. FactorialValue(0, r) -> r = 1
ensures forall n: Int, r: Int, prev: Int.
    (Nat(n) and Positive(n) and FactorialValue(dec(n), prev) and FactorialValue(n, r)) -> r = mul(n, prev)

spec factorial_query(n: Int) -> result: Int
requires n = 5
ensures FactorialValue(n, result)
ensures result = 120

