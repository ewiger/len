type Job
type Worker
type Int

rel Ready(Job)
rel Assigned(Job, Worker)
rel Demand(Job, Int)
rel Capacity(Worker, Int)
rel HigherPriority(Job, Job)
rel ScheduledBefore(Job, Job)
rel Failed(Job)
rel RetryCount(Job, Int)
rel WithinLimit(Int)

spec scheduling_rules(j: Job) -> w: Worker
ensures forall j: Job. Ready(j) -> exists w: Worker. Assigned(j, w)
ensures forall j: Job, w: Worker, need: Int, cap: Int.
    (Assigned(j, w) and Demand(j, need) and Capacity(w, cap)) -> need <= cap
ensures forall j1: Job, j2: Job.
    (Ready(j1) and Ready(j2) and HigherPriority(j1, j2)) -> ScheduledBefore(j1, j2)
ensures forall j: Job, retries: Int.
    (Failed(j) and RetryCount(j, retries)) -> WithinLimit(retries)

