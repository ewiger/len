type Job
type Worker
type Int

rel Ready(Job)
rel Assigned(Job, Worker)
rel Demand(Job, Int)
rel Capacity(Worker, Int)
rel HigherPriority(Job, Job)
rel ScheduledBefore(Job, Job)
rel Failed(Job)
rel RetryCount(Job, Int)
rel WithinLimit(Int)

spec scheduler_policy(j: Job) -> w: Worker
requires Ready(j)
ensures Assigned(j, w)
ensures exists need: Int, cap: Int. (Demand(j, need) and Capacity(w, cap)) and need <= cap
ensures forall other: Job. (Ready(other) and HigherPriority(other, j)) -> ScheduledBefore(other, j)
ensures exists retries: Int. Failed(j) -> (RetryCount(j, retries) and WithinLimit(retries))
