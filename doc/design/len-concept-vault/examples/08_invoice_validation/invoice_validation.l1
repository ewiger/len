type Invoice
type LineItem
type Money
type Rate

rel HasLine(Invoice, LineItem)
rel LineAmount(LineItem, Money)
rel Subtotal(Invoice, Money)
rel TaxRate(Invoice, Rate)
rel TaxAmount(Invoice, Money)
rel Total(Invoice, Money)
rel ValidInvoice(Invoice)
fn add_money(a: Money, b: Money) -> Money

spec invoice_totals(inv: Invoice) -> total: Money
requires Total(inv, total)
ensures forall line: LineItem, amount: Money. HasLine(inv, line) -> LineAmount(line, amount)
ensures exists subtotal: Money, tax: Money. Subtotal(inv, subtotal) and TaxAmount(inv, tax) and total = add_money(subtotal, tax)
ensures ValidInvoice(inv)
