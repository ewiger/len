type Invoice
type LineItem
type Money
type Rate

rel HasLine(Invoice, LineItem)
rel LineAmount(LineItem, Money)
rel Subtotal(Invoice, Money)
rel TaxRate(Invoice, Rate)
rel TaxAmount(Invoice, Money)
rel Total(Invoice, Money)
rel ValidInvoice(Invoice)
fn add_money(a: Money, b: Money) -> Money

spec invoice_consistency(inv: Invoice) -> total: Money
ensures forall inv: Invoice, total: Money, subtotal: Money, tax: Money.
    (Total(inv, total) and Subtotal(inv, subtotal) and TaxAmount(inv, tax)) -> total = add_money(subtotal, tax)
ensures forall inv: Invoice. ValidInvoice(inv) -> exists total: Money. Total(inv, total)

