type User
type Document
type Project

rel Admin(User)
rel Editor(User)
rel Viewer(User)
rel InProject(User, Project)
rel DocInProject(Document, Project)
rel PublicDoc(Document)
rel Archived(Document)
rel CanRead(User, Document)
rel CanWrite(User, Document)
rel CanDelete(User, Document)

spec document_policy(u: User, d: Document) -> ok: Document
ensures Admin(u) -> CanRead(u, d)
ensures Admin(u) -> CanWrite(u, d)
ensures (Viewer(u) and PublicDoc(d)) -> CanRead(u, d)
ensures exists p: Project. (Editor(u) and InProject(u, p) and DocInProject(d, p)) -> CanWrite(u, d)
ensures Archived(d) -> not CanDelete(u, d)
