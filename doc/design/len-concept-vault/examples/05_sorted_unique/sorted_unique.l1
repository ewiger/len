type List
type Int

rel Input(List)
rel Output(List)
rel Member(Int, List)
rel Sorted(List)
rel NoDuplicates(List)
rel DistinctInputValue(Int, List)

spec normalize_list(xs: List) -> ys: List
requires Input(xs)
ensures Output(ys)
ensures Sorted(ys)
ensures NoDuplicates(ys)
ensures forall x: Int. Member(x, ys) -> Member(x, xs)
ensures forall x: Int. DistinctInputValue(x, xs) -> Member(x, ys)

