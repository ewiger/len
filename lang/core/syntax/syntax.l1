# meta language features like `Expr` are to be used in conjuction with keyword `syntax`
type Expr

# A complete list of reserved keywords for level 1 of `len` language

keyword type
keyword rel
keyword syntax
keyword keyword
keyword implies
keyword import
keyword trait
keyword impl
keyword def
keyword spec
keyword given
keyword must
keyword forall
keyword exists
keyword and
keyword or
keyword not
keyword iff
keyword where
keyword from
keyword in
