type Bool
type Formula
type Expr
type Context

const True : Bool
const False : Bool

rel Eval(ctx: Context, f: Formula, b: Bool)
rel Holds(ctx: Context, f: Formula)

spec holds_def
    given ctx: Context
    given f: Formula
    must Holds(ctx, f) iff Eval(ctx, f, True)

quasi Eval
    case FormulaTrue
        Eval(ctx, FormulaTrue, True)

    case FormulaFalse
        Eval(ctx, FormulaFalse, False)

    case not a
        Eval(ctx, not a, True) when Eval(ctx, a, False)
        Eval(ctx, not a, False) when Eval(ctx, a, True)

    case a and b
        Eval(ctx, a and b, True) when Eval(ctx, a, True) and Eval(ctx, b, True)
        Eval(ctx, a and b, False) when Eval(ctx, a, False)
        Eval(ctx, a and b, False) when Eval(ctx, b, False)

    case a or b
        Eval(ctx, a or b, True) when Eval(ctx, a, True)
        Eval(ctx, a or b, True) when Eval(ctx, b, True)
        Eval(ctx, a or b, False) when Eval(ctx, a, False) and Eval(ctx, b, False)