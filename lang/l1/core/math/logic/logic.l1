type Bool
type Formula
type Expr
type Context

const True : Bool
const False : Bool

rel Eval(ctx: Context, f: Formula, b: Bool)
rel Holds(ctx: Context, f: Formula)

spec holds_def
    given ctx: Context
    given f: Formula
    must Holds(ctx, f) iff Eval(ctx, f, True)

fn eval(ctx: Context, f: Formula) -> b: Bool
    implements Eval(ctx, f, b)
    quasi:
        if f = FormulaTrue:
            return True
        if f = FormulaFalse:
            return False
        note if f = not a, recursively evaluate a and negate the result
        note if f = a and b, recursively evaluate both operands and return their conjunction
        note if f = a or b, recursively evaluate both operands and return their disjunction