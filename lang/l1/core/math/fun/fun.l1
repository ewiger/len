import core.math.set

type Fn

rel Function(A: Set, B: Set, f: Fn)
rel Injective(f: Fn)
rel Surjective(f: Fn)
rel Bijective(f: Fn)


# Definition of bijective function
spec bijective_fun_def
    given A, B: Set
    given f: Fn
    must Function(A, B, f) and Bijective(f) iff
        Function(A, B, f) and Injective(f) and Surjective(f)